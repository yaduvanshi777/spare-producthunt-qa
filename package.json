{
  "name": "spare-producthunt-qa",
  "version": "1.0.0",
  "description": "Comprehensive QA Test Strategy, Exploratory & Security Assessment, and Automated Test Suites for Product Hunt",
  "author": "Spare QA Candidate",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test:api": "bun test tests/api",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "bun run test:api && bun run test:e2e",
    "typecheck": "tsc --noEmit",
    "codegen": "playwright codegen https://www.producthunt.com"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/bun": "^1.4.4",
    "@types/node": "^22.10.2",
    "dotenv": "^16.4.7",
    "typescript": "^5.7.2",
    "zod": "^3.24.1"
  }
}
