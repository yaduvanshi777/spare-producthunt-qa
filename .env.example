# Product Hunt GraphQL API Configuration
# Get a developer token at https://www.producthunt.com/v2/oauth/applications
PRODUCT_HUNT_API_TOKEN=your_developer_token_here

# Base URLs
PRODUCT_HUNT_API_URL=https://api.producthunt.com/v2/api/graphql
PRODUCT_HUNT_WEB_URL=https://www.producthunt.com

# Playwright Test Options
CI=false
HEADLESS=true
